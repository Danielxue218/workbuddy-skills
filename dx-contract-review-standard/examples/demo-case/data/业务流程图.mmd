%%{init: {
  'theme': 'base',
  'themeVariables': {
    'fontFamily': '"PingFang SC", "Microsoft YaHei", "Noto Sans SC", "Helvetica Neue", Arial, sans-serif',
    'fontSize': '14px',
    'primaryColor': '#F8FAFC',
    'primaryTextColor': '#000000',
    'primaryBorderColor': '#475569',
    'lineColor': '#64748B',
    'tertiaryColor': '#FFFFFF',
    'background': '#FFFFFF',
    'mainBkg': '#F8FAFC',
